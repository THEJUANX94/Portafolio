---
import type { Locale } from '../lib/i18n';
import { t } from '../i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
---
<button
  type="button"
  data-theme-toggle
  aria-label={t(lang, 'theme.toggle')}
  title={t(lang, 'theme.toggle')}
  aria-pressed="false"
  class="rounded-full border border-border bg-surface p-2 text-text hover:bg-surface-soft focus-visible:outline-2 focus-visible:outline-primary"
>
  <svg aria-hidden="true" class="theme-icon-moon block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
  </svg>
  <svg aria-hidden="true" class="theme-icon-sun block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
  </svg>
</button>
<script>
  const KEY = 'theme';
  function current(): 'light' | 'dark' {
    const set = document.documentElement.dataset.theme;
    if (set === 'light' || set === 'dark') return set;
    return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }
  function sync() {
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      btn.setAttribute('aria-pressed', current() === 'dark' ? 'true' : 'false');
    }
  }
  sync();
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    btn.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem(KEY, next); } catch { /* almacenamiento no disponible */ }
      sync();
    });
  }
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', sync);
</script>
