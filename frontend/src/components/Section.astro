---
interface Props {
  id: string;
  title: string;
  highlight?: boolean;
  delay?: number;
  vtName?: string;
}
const { id, title, highlight = false, delay = 0, vtName } = Astro.props;
---
<section
  id={id}
  aria-labelledby={`${id}-title`}
  data-cascade
  class:list={[
    'rise-in rounded-2xl border p-6 sm:p-8',
    highlight ? 'border-accent bg-surface-soft' : 'border-border bg-surface',
  ]}
  style={`animation-delay: ${delay}ms`}
>
  <h2 id={`${id}-title`} class="text-xl font-bold text-primary" style={vtName ? `view-transition-name: ${vtName}` : undefined}>{title}</h2>
  <div class="mt-4">
    <slot />
  </div>
</section>
